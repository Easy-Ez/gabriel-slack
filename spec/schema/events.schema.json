            "id": {
              "type": "string"
            },
            "displayName": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "channel": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "target": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "message",
                "file"
              ]
            },
            "ts": {
              "$ref": "#/$defs/Ts"
            },
            "threadRootTs": {
              "$ref": "#/$defs/Ts"
            },
            "fileId": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "itemUserId": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "eventId",
        "reaction",
        "user",
        "channel",
        "target"
      ],
      "additionalProperties": false
    },
