        },
        "channel": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "threadRootTs": {
          "$ref": "#/$defs/Ts"
        }
      },
      "required": [
        "type",
        "eventId",
        "user",
        "channel"
      ],
      "additionalProperties": false
    },
    "interaction.reaction_added": {
